# Environment variables for Dapur Qomaruddin (Supabase Self-Hosted Storage)
GEMINI_API_KEY=
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Storage Buckets (Mapped to Docker Local HDD /data/datadapur/)
VITE_SUPABASE_STORAGE_PHOTOS_BUCKET=photos
VITE_SUPABASE_STORAGE_SIGNATURES_BUCKET=signatures
VITE_SUPABASE_STORAGE_DOCUMENTS_BUCKET=documents
