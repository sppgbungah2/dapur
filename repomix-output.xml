-- Aktifkan RLS pada seluruh tabel operasional
ALTER TABLE day_menus ENABLE ROW LEVEL SECURITY;
ALTER TABLE sops ENABLE ROW LEVEL SECURITY;
ALTER TABLE sop_tasks ENABLE ROW LEVEL SECURITY;
