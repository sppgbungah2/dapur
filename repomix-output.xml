            emp.name,
            emp.role,
            String(emp.hadir),
            String(emp.izin),
            String(emp.sakit),
            String(emp.alpa),
            emp.notes.length > 0 ? emp.notes.join(' | ') : 'Aktif penuh sesuai SOP'
          ]);
