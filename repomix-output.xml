                            Buka
                          </button>
                          {onDeleteSOP && (
                            <button
                              onClick={() => {
                                if (window.confirm(`Hapus berkas SOP ${sop.division} tanggal ${formatIndoDate(sop.date)}? Berkas SOP yang dihapus tidak dapat dikembalikan.`)) {
                                  onDeleteSOP(sop.id);
