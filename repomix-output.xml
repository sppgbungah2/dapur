            name: todayItem.name,
            stokAwal: todayItem.stokAkhir,
            barangMasuk: 0,
            stokAkhir: todayItem.stokAkhir,
            uom: todayItem.uom,
            expiredDate: todayItem.expiredDate
          });
        }
      });

      return {
        ...prev,
        [actualNextDateStr]: updatedNextDayList
      };
    });

