-- G. TABEL SURAT JALAN (surat_jalan_docs)
CREATE TABLE public.surat_jalan_docs (
  id TEXT PRIMARY KEY,
  date TEXT NOT NULL,
  sj_no TEXT,
  sj_kepada TEXT,
