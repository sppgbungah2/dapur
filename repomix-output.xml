          updatedNextDayList[idx] = {
            ...nextItem,
            stokAwal: todayItem.stokAkhir, // carry over
            stokAkhir: todayItem.stokAkhir + nextItem.barangMasuk
          };
        } else {
          updatedNextDayList.push({
            id: `st-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`,
